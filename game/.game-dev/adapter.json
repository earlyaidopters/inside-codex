{
  "schema": "game_dev.adapter.v1",
  "id": "inside-codex",
  "name": "Inside Codex browser capture",
  "version": "1.0.0",
  "scenarios": [
    {
      "id": "floor-finish",
      "title": "Floor and stage material comparison",
      "command": {
        "executable": "tools/capture-floor-scenario.mjs",
        "arguments": [
          "{param.variant}"
        ],
        "workingDirectory": "."
      },
      "parameters": {
        "variant": {
          "type": "enum",
          "values": [
            "baseline",
            "candidate"
          ],
          "default": "baseline",
          "required": false
        }
      },
      "capabilities": [
        "gpu"
      ],
      "timeoutSeconds": 60,
      "outputs": {
        "format": "game-dev-capture-v1",
        "path": "capture.json"
      }
    },
    {
      "id": "promenade-finish",
      "title": "Promenade layout and rebaked lighting",
